# ==========================================
# Byone Arena - Environment Configuration
# ==========================================
# Copy file ini menjadi .env dan sesuaikan nilainya

# ==========================================
# Application
# ==========================================
APP_NAME=Byone Arena
APP_ENV=development       # development | production
# Development lokal: 8081 (production/client memakai 8080)
PORT=8080
LOG_LEVEL=info            # debug | info | warn | error

# ==========================================
# Database PostgreSQL
# ==========================================
DB_HOST=postgres         # Ganti 'postgres' jika menggunakan Docker
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=.|W.zExVV%lE  # Ganti dengan password yang aman!
DB_NAME=byone_arena
DB_SSLMODE=disable        # disable | require | verify-full

# ==========================================
# White-label (opsional)
# ==========================================
# Prefix nama function/procedure SQL di database, contoh: byoneStartSession.
# Ganti untuk deployment client tertentu (hanya huruf/angka, diawali huruf),
# WAJIB sama dengan prefix yang dipakai saat menjalankan migrasi (cmd/migrate)
# di database milik client tersebut.
SP_PREFIX=byone

# ==========================================
# JWT Authentication
# ==========================================
# Kosongkan untuk dibuat otomatis saat server pertama kali jalan.
# Disimpan di jwt.secret (Windows: %PROGRAMDATA%\ByoneArena\jwt.secret).
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ==========================================
# pgAdmin (opsional, hanya untuk development)
# ==========================================
PGADMIN_EMAIL=admin@byone.local
PGADMIN_PASSWORD=admin123

# ==========================================
# Lisensi offline (Ed25519)
# ==========================================
# Public key sudah DITANAM di binary server, jadi tidak perlu diisi.
# Baris ini hanya untuk override (white-label/rotasi kunci).
# LICENSE_PUBLIC_KEY=
# Masa uji coba bila belum ada lisensi (hari) dan batas unitnya.
LICENSE_TRIAL_DAYS=14
LICENSE_TRIAL_UNITS=2
# Masa tenggang setelah lisensi kedaluwarsa sebelum mode read-only.
LICENSE_GRACE_DAYS=14
